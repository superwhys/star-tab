{
  "manifest_version": 3,
  "name": "星页",
  "short_name": "星页",
  "version": "0.1.0",
  "description": "如星辰般的新标签页：时钟、默认搜索与书签星图。",
  "permissions": ["bookmarks", "favicon", "search", "storage"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

